{
  "expo": {
    "name": "EduQ",
    "slug": "teacher-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icone.png",
    "scheme": "teachermobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icone.png"
    },
    "android": {
      "package": "com.mosef_758752955.teachermobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icone.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icone.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F7FF",
          "image": "./assets/images/icone.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-build-properties",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
